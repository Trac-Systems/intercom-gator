{
  "name": "intercom-gator",
  "version": "0.1.11",
  "private": true,
  "description": "Decentralized market data + social layer for agent harnesses on Intercom",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "workspaces": ["packages/*"],
  "overrides": {
    "@metamask/utils@11.12.1": {
      "uuid": "11.1.1"
    }
  },
  "bin": { "gator": "bin/gator.js" },
  "scripts": {
    "start": "node bin/gator.js start",
    "release:pack": "node scripts/release-pack.mjs",
    "test": "node --test \"packages/*/test/**/*.test.js\""
  }
}
